#!/bin/sh
echo "🔍 Running pre-push checks..."

# Detect files pushed (vs remote); fall back to last commit when no tracking remote yet
PUSHED=$(git diff --name-only "@{push}..HEAD" 2>/dev/null || git diff --name-only "HEAD~1..HEAD" 2>/dev/null || echo "")

PYTHON_CHANGED=$(echo "$PUSHED" | grep -c '\.py$' 2>/dev/null || echo "0")
FRONTEND_CHANGED=$(echo "$PUSHED" | grep -c '^apps/web/' 2>/dev/null || echo "0")

if [ "$PYTHON_CHANGED" -gt 0 ]; then
  echo "🐍 Python changes detected - running ruff..."
  python -m ruff check services/ || { echo "  ❌ Ruff lint failed!"; exit 1; }
  echo "  ✅ Ruff passed"
fi

if [ "$FRONTEND_CHANGED" -gt 0 ]; then
  echo "📦 Frontend changes detected..."

  echo "  ├─ Running ESLint..."
  npm --prefix apps/web run lint || { echo "  │  ❌ ESLint failed!"; exit 1; }
  echo "  │  ✅ ESLint passed"

  echo "  └─ Running TypeScript check..."
  npm --prefix apps/web run type:check || { echo "     ❌ TypeScript check failed!"; exit 1; }
  echo "     ✅ TypeScript check passed"
fi

echo "✅ All pre-push checks passed!"

# Local E2E secrets for running tests against the preview environment.
# Copy this file to .env.e2e.local and fill in your values.
# NEVER commit .env.e2e.local — it is gitignored.

# ── Auth0 config (auto-fetched from Key Vault if you have az CLI logged in) ──
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# AUTH0_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Test account credentials (required — not in Key Vault) ──────────────────
# Ask the team for these values, or find them in the GitHub repository secrets.
AUTH0_ADMIN_TEST_EMAIL=
AUTH0_ADMIN_TEST_PASSWORD=

AUTH0_USER_TEST_EMAIL=
AUTH0_USER_TEST_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# YT_SUMMARIZER_API_KEY=
